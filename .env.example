# Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# CORS Configuration
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# RapidAPI Configuration (for deployment)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_API_ID=your_api_id_here
RAPIDAPI_VERSION_ID=your_version_id_here

# App Information
APP_NAME=My API
APP_VERSION=0.1.0
CONTACT_EMAIL=support@your-domain.com
CONTACT_URL=https://your-website.com
TERMS_OF_SERVICE=https://your-site.com/terms
